# Server Configuration
PORT=5000

# MongoDB Connection URI (MongoDB Atlas recommended)
# Get yours from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivlok-palace?retryWrites=true&w=majority

# Gmail SMTP Credentials
# Use a Gmail App Password (NOT your regular password)
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=shivlokpalace@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Admin email where inquiry notifications are sent
ADMIN_EMAIL=shivlokpalace@gmail.com

# Client URL (for CORS - your frontend URL)
CLIENT_URL=http://localhost:5173

# Admin API Secret Token (used to protect admin endpoints)
# Generate a strong random string — e.g., openssl rand -hex 32
ADMIN_SECRET=your_strong_admin_secret_here
